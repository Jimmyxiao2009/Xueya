# Development-only example. Never use these values in production.
VERRUCKT_ENV=development
VERRUCKT_BIND=0.0.0.0
VERRUCKT_PORT=8080
VERRUCKT_LOG_FORMAT=text

DATABASE_URL=postgres://verruckt:verruckt@localhost:5432/verruckt
VERRUCKT_ACCESS_TOKEN_SECRET=dev-only-change-me-access-secret
VERRUCKT_ACCESS_TOKEN_TTL_SECS=1800
VERRUCKT_REFRESH_TOKEN_TTL_DAYS=30
VERRUCKT_TOKEN_ISSUER=verruckt-cloud
VERRUCKT_CORS_ORIGINS=
VERRUCKT_REQUEST_TIMEOUT_SECS=30
VERRUCKT_MAX_BODY_BYTES=4194304
VERRUCKT_MAX_FILE_BYTES=2147483648

VERRUCKT_OBJECT_STORAGE_ENDPOINT=http://localhost:9000
VERRUCKT_OBJECT_STORAGE_REGION=us-east-1
VERRUCKT_OBJECT_STORAGE_BUCKET=verruckt-cloud
VERRUCKT_OBJECT_STORAGE_ACCESS_KEY=minioadmin
VERRUCKT_OBJECT_STORAGE_SECRET_KEY=minioadmin
VERRUCKT_OBJECT_STORAGE_FORCE_PATH_STYLE=true
VERRUCKT_OBJECT_STORAGE_PRESIGN_TTL_SECS=900

# Leave VERRUCKT_UPSTREAM_BASE_URL empty to disable the official AI gateway.
VERRUCKT_UPSTREAM_BASE_URL=
VERRUCKT_UPSTREAM_API_KEY=
VERRUCKT_UPSTREAM_CHAT_MODEL=gpt-4o-mini
VERRUCKT_UPSTREAM_REASONING_MODEL=gpt-4o
VERRUCKT_UPSTREAM_EMBEDDING_MODEL=text-embedding-3-small
VERRUCKT_MODEL_FAST=gpt-4o-mini
VERRUCKT_MODEL_STANDARD=gpt-4o-mini
VERRUCKT_MODEL_REASONING=gpt-4o
VERRUCKT_MODEL_EMBEDDING=text-embedding-3-small
VERRUCKT_AI_RATE_LIMIT_PER_MINUTE=60
VERRUCKT_AI_REQUEST_TIMEOUT_SECS=120
VERRUCKT_AI_MAX_MESSAGES=64
VERRUCKT_AI_MAX_TOKENS=8192
VERRUCKT_AI_MAX_EMBEDDING_INPUTS=128
VERRUCKT_AI_MAX_EMBEDDING_TOTAL_CHARS=131072
