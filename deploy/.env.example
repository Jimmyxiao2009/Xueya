# Copy this file to deploy/.env and fill in real values before deploying.
# Never commit the filled deploy/.env.

# Required: PostgreSQL password used by the bundled postgres service.
# Use URL-safe characters (letters, digits, - _ . ~). It is embedded in DATABASE_URL.
ORBIT_DB_PASSWORD=replace-with-a-long-random-password

# Required: signing secret for account access tokens.
VERRUCKT_ACCESS_TOKEN_SECRET=replace-with-a-long-random-secret

# Required: bearer token for the admin endpoints.
ORBIT_ADMIN_TOKEN=replace-with-a-long-random-admin-token

# Public URL users will open. Must match scheme/host/port exactly.
# Use https://... behind an HTTPS reverse proxy.
ORBIT_PUBLIC_ORIGIN=https://orbit.example.com

# Bind/port on the host. For a fresh public server behind a reverse proxy:
#   ORBIT_HTTP_BIND=127.0.0.1
# If exposing the container directly without a proxy, use 0.0.0.0 and firewall it.
ORBIT_HTTP_BIND=127.0.0.1
ORBIT_HTTP_PORT=1420

# AI gateway used by the server-side learning engine.
# Must be an OpenAI-compatible base URL ending in /v1.
ORBIT_AI_BASE_URL=https://your-ai-gateway.example.com/v1
ORBIT_AI_API_KEY=replace-with-your-api-key
ORBIT_AI_MODEL=your-model-name
ORBIT_AI_PROTOCOL=chat_completions
ORBIT_EMBEDDING_MODEL=text-embedding-3-small

# Optional web search provider.
ORBIT_BRAVE_API_KEY=

# Defaults to production; do not set to development on a public server.
VERRUCKT_ENV=production
